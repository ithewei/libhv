				cpputil/hpath.h\
				cpputil/hdir.h\
				cpputil/hurl.h\
				cpputil/hscope.h\
				cpputil/hthreadpool.h\
				cpputil/hasync.h\
				cpputil/hobjectpool.h\
				cpputil/ifconfig.h\
				cpputil/iniparser.h\
				cpputil/json.hpp\
				cpputil/singleton.h\
				cpputil/LRUCache.h\
				cpputil/ThreadLocalStorage.h\

EVPP_HEADERS  = evpp/Buffer.h\
